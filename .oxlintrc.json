    {
      "files": ["*.yaml", "**/*.yaml", "*.yml", "**/*.yml"],
      "rules": {
        "no-irregular-whitespace": "off"
      }
    }
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    }
  ]
