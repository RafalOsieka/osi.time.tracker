{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "trailingComma": "all",
  "bracketSpacing": true,
  "htmlWhitespaceSensitivity": "ignore",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    ".nuxt",
    ".output",
    "node_modules",
    "dist",
    "pnpm-lock.yaml",
    "server/db/migrations",
    ".junie",
    "AGENTS.md",
    "openspec",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tools/oxlint/anti-slop/**"
  ]
}
