{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "osi-time-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @osi/remote-trackers build && concurrently -k -n trackers,web -c cyan,green \"pnpm --filter @osi/remote-trackers dev\" \"pnpm --filter @osi/web dev\"",
    "build": "pnpm --filter @osi/remote-trackers build && pnpm --filter @osi/web build",
    "generate": "pnpm --filter @osi/remote-trackers build && pnpm --filter @osi/web generate",
    "preview": "pnpm --filter @osi/web preview",
    "type-check": "pnpm --filter @osi/remote-trackers type-check && pnpm --filter @osi/remote-trackers build && pnpm --filter @osi/web type-check",
    "test:unit": "pnpm --filter @osi/remote-trackers build && pnpm --filter @osi/remote-trackers test && pnpm --filter @osi/web test:unit && vitest run --project anti-slop",
    "test:e2e": "pnpm --filter @osi/web test:e2e",
    "test:e2e:db": "pnpm --filter @osi/web test:e2e:db",
    "test:e2e:api": "pnpm --filter @osi/web test:e2e:api",
    "test:e2e:ui": "pnpm --filter @osi/web test:e2e:ui",
    "test:e2e:dev": "pnpm --filter @osi/web test:e2e:dev",
    "test:nuxt": "pnpm --filter @osi/remote-trackers build && pnpm --filter @osi/web test:nuxt",
    "test:coverage": "pnpm --filter @osi/remote-trackers build && pnpm --filter @osi/web test:coverage",
    "package:check": "pnpm --filter @osi/remote-trackers build && pnpm --filter @osi/remote-trackers type-check && pnpm --filter @osi/remote-trackers test",
    "db:generate": "pnpm --filter @osi/web db:generate",
    "db:migrate": "pnpm --filter @osi/web db:migrate",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@oxlint/plugins": "^1.81.0",
    "@typescript-eslint/parser": "^8.69.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.81.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "author": "Rafal Osieka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafalOsieka/osi.time.tracker.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "pnpm": "^12"
  },
  "packageManager": "pnpm@12.3.0"
}
