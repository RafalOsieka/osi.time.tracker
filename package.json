{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "osi-time-tracker",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "type-check": "nuxt typecheck",
    "test:unit": "vitest --project unit",
    "test:e2e": "vitest --project e2e",
    "test:e2e:dev": "cross-env NUXT_TEST_DEV=1 vitest --project e2e",
    "test:nuxt": "vitest --project nuxt",
    "test:coverage": "vitest run --coverage --project unit --project nuxt",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nuxt/ui": "^4.10.0",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "nuxt-security": "^2.6.0",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.4",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.123",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.1.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "^2.4.11",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "happy-dom": "^20.11.2",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "author": "Rafal Osieka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RafalOsieka/osi.time.tracker.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "pnpm": "^11"
  },
  "packageManager": "pnpm@11.21.0"
}
