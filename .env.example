# Copy to `.env`. Nuxt, the migrator and Docker Compose all read this one file.
#
#   Host development   -> `pnpm dev` / `pnpm db:migrate` (values below work as-is)
#   Dev compose        -> `docker compose [--profile trackers] up -d` (+ `pnpm trackers:seed`)

# ── Host development ─────────────────────────────────────────────────────────
# Read by `pnpm dev` and `pnpm db:migrate` running on the host.
# Requires PostgreSQL >= 18 (native uuidv7()).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/osi_time_tracker

# Nuxt app secret (32+ characters); the session cookie is sealed with a key derived from it.
# DEVELOPMENT VALUE — for production generate a fresh one: `openssl rand -base64 32`.
NUXT_APP_SECRET=change-me-to-a-random-32-plus-char-secret

# Optional: the migrator seeds this user if it does not exist yet
# (email lower-cased, password hashed).
BOOTSTRAP_USER_EMAIL=admin@example.com
BOOTSTRAP_USER_PASSWORD=change-me-to-a-random-secure-password
# Optional profile of that user; editable later on the Profile page.
# Display name defaults to the email local part, timezone (IANA id) to UTC.
# BOOTSTRAP_USER_DISPLAY_NAME=Admin
# BOOTSTRAP_USER_TIMEZONE=Europe/Warsaw

# Optional server log verbosity: 0 fatal, 1 error, 2 warn, 3 info (default), 4 debug, 5 trace.
# Raise to 4 to also log every database statement when troubleshooting.
# CONSOLA_LEVEL=3

# ── Dev compose (docker-compose.yml) ─────────────────────────────────────────
# Defaults match DATABASE_URL above; uncomment to override. Keep them in sync.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=osi_time_tracker
# POSTGRES_PORT=5432
# PGADMIN_DEFAULT_EMAIL=admin@example.com
# PGADMIN_DEFAULT_PASSWORD=admin
# PGADMIN_PORT=8080

# Trackers profile only (`docker compose --profile trackers up -d`, then
# `pnpm trackers:seed`). The dev API keys below are installed on the LOCAL
# trackers by the entrypoint (Redmine) and the seed (OpenProject); paste them
# into the OSI tracker form. They are worthless anywhere else.
REDMINE_DEV_API_KEY=d3adbeefd3adbeefd3adbeefd3adbeefd3adbeef
OPENPROJECT_DEV_API_KEY=opapi-d3adbeefd3adbeefd3adbeefd3adbeefd3adbeefd3adbeefd3adbeefd3adbeef
REDMINE_ADMIN_PASSWORD=admin
# OPENPROJECT_PORT=8090
# OPENPROJECT_ADMIN_PASSWORD=admin
# OPENPROJECT_SECRET_KEY_BASE=   # `openssl rand -hex 64`
# REDMINE_PORT=8091
# REDMINE_DB_PASSWORD=redmine
# REDMINE_SECRET_KEY_BASE=       # `openssl rand -hex 64`
