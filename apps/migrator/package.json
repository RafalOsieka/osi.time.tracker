    "type-check": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vp test run"
  },
  "dependencies": {
    "@adonisjs/hash": "^9.1.1",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
