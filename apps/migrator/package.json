{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@osi/migrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Applies the committed SQL migrations and seeds the bootstrap user",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "tsx src/cli.ts",
