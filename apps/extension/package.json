{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@osi/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "pnpm --dir ../.. exec oxlint apps/extension && eslint .",
    "type-check": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser"
  },
  "dependencies": {
    "@osi/extension-protocol": "workspace:*",
    "@osi/remote-trackers": "workspace:*",
    "vue": "^3.5.42",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint-plugin-vue": "^10.11.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=24"
  }
}
