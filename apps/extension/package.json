{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@osi/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build",
    "dev": "vp build --watch",
    "lint": "pnpm --dir ../.. exec vp lint apps/extension && eslint .",
    "type-check": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vp test run --project unit",
    "test:unit": "vp test run --project unit",
    "test:browser": "vp test run --project browser"
  },
  "dependencies": {
    "@osi/extension-protocol": "workspace:*",
    "@osi/remote-trackers": "workspace:*",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint-plugin-vue": "^10.11.1",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vue-tsc": "^3.3.11",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
