{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@osi/time-tracker-extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build",
    "dev": "vp build --watch",
    "lint": "vp lint && eslint .",
    "type-check": "vp build && vue-tsc -p tsconfig.json --noEmit",
    "test": "vp test run --project unit",
    "test:unit": "vp test run --project unit",
    "test:browser": "vp test run --project browser"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.3",
    "@osi/time-tracker-extension-protocol": "workspace:*",
    "@osi/time-tracker-remote-trackers": "workspace:*",
    "vue": "^3.5.43",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^20.14.5",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=24"
  }
}
